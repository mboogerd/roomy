# Implementer worker: Codex CLI, headless. Build: docker build -f docs/orchestration/Dockerfile.codex -t roomy-worker-codex .
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex
USER node
ENV HOME=/home/node
# bind mounts can surface with a foreign uid; git refuses "dubious ownership" otherwise
RUN git config --global --add safe.directory '*' && mkdir -p /home/node/.codex
WORKDIR /work
